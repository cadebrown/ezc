{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^.*[\\(\\[\\{]\\s*(#.*)?$",
    "decreaseIndentPattern": "^\\s*[\\)\\]\\}]"
  },
  "wordPattern": "[@$]?[a-zA-Z_][a-zA-Z0-9_]*|0x[0-9a-fA-F]+[a-zA-Z0-9]*|[0-9]+\\.?[0-9]*([eE][+-]?[0-9]+)?[a-zA-Z0-9]*|&[!?/]|\\?\\?|[=!<>]=|[+\\-*/%^~|,;:.]"
}
