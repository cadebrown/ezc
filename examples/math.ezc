#!/usr/bin/env ezc

# Basic arithmetic
3 4 + :                  # 7
2 100 ^ :                # 2^100 (big integer)

# Named functions
(, *) @square
(, $square ! $square !) @fourth

5 $square ! :            # 25
2 $fourth ! :            # 16

# Sum and product via fold
[1 2 3 4 5] 0 (+) &/ :  # 15
[1 2 3 4 5] 1 (*) &/ :  # 120

# Map with a captured variable
10 @offset
[1 2 3] ($offset +) &! : # [11 12 13]

# Filter evens from 1..10
10 iota (1 +) &! (2 % 0 ==) &? : # [2 4 6 8 10]

# Min and max
3 7 min :                # 3
3 7 max :                # 7
