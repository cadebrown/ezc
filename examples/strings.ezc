#!/usr/bin/env ezc

# String operations
"hello" " " | "world" | :         # "hello world"
"hello world" " " cut :           # ["hello" "world"]
["one" "two" "three"] ", " cat :  # "one, two, three"

# Reverse a string
"racecar" , rev == :               # 1 (palindrome check)

# String length
"hello" len :                      # 5
