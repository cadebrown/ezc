#!/usr/bin/env ezc

# List creation
5 iota , :                     # [0 1 2 3 4]

# Length, indexing, head/tail
len :                          # 5

[10 20 30]
, 0 nth :                      # 10 (first element)
, hd :                         # 10 (same thing)
tl :                           # [20 30]

# Reverse and sort
[3 1 4 1 5] , rev :            # [5 1 4 1 3]
srt :                          # [1 1 3 4 5]

# Map: double each element
[1 2 3] (2 *) &! :             # [2 4 6]

# Filter: keep elements > 2
[1 2 3 4 5] (2 >) &? :         # [3 4 5]

# Fold: sum and product
[1 2 3 4 5] 0 (+) &/ :         # 15
[1 2 3 4 5] 1 (*) &/ :         # 120

# Splat: unpack a list onto the stack
[10 20 30] ! + + :              # 60

# Compose lists
[1 2] [3 4] | :                 # [1 2 3 4]
