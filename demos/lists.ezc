#!/usr/bin/env ezc

# List creation
5 iota , :                       # [0 1 2 3 4]

# Length, indexing, head/tail
len :                            # 5
[10 20 30]
, 0 nth :                        # 10
, hd :                           # 10
tl :                             # [20 30]

# Reverse and sort
[3 1 4 1 5] , rev :              # [5 1 4 1 3]
srt :                            # [1 1 3 4 5]

# Map, filter, fold
[1 2 3] (2 *) map :              # [2 4 6]
[1 2 3 4 5] (2 >) fil :          # [3 4 5]
[1 2 3 4 5] 0 (+) red :          # 15
[1 2 3 4 5] 1 (*) red :          # 120

# Splat a list onto the stack
[10 20 30] ! + + :               # 60

# Compose lists
[1 2] [3 4] | :                  # [1 2 3 4]
